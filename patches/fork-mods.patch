+bool ReadFileFromSDImage(const std::string& path, std::string* out)
+{
+  constexpr FSIZE_t MAX_FILE_SIZE = 8 * 1024 * 1024;
+
+  const std::string image_path = File::GetUserPath(F_WIISDCARDIMAGE_IDX);
+  if (image_path.empty() || !File::Exists(image_path))
+    return false;
+
+  std::lock_guard lk(s_fatfs_mutex);
+  SDCardFatFsCallbacks callbacks;
+  s_callbacks = &callbacks;
+  Common::ScopeGuard callbacks_guard{[] { s_callbacks = nullptr; }};
+
+  File::IOFile image;
+  callbacks.m_image = &image;
+  callbacks.m_deterministic = true;  // nothing is written
+  if (!image.Open(image_path, "rb"))
+    return false;
+
+  FATFS fs{};
+  if (f_mount(&fs, "", 0) != FR_OK)
+    return false;
+  Common::ScopeGuard unmount_guard{[] { f_unmount(""); }};  // before the image is closed
+
+  FIL file;
+  if (f_open(&file, path.c_str(), FA_READ) != FR_OK)
+    return false;
+  const FSIZE_t size = f_size(&file);
+  if (size > MAX_FILE_SIZE)
+  {
+    f_close(&file);
+    return false;
+  }
+  std::string data(static_cast<size_t>(size), '\0');
+  UINT bytes_read = 0;
+  const FRESULT result =
+      size == 0 ? FR_OK : f_read(&file, data.data(), static_cast<UINT>(size), &bytes_read);
+  f_close(&file);
+  if (result != FR_OK || bytes_read != size)
+    return false;
+
+  *out = std::move(data);
+  return true;
+}
