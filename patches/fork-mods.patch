+
+// What Project M, Project+ and other BrawlEX-based mods need from Gecko OS's gameconfig.txt.
+// Gecko OS (boot.elf) can't run inside Dolphin, so its configuration is read here instead.
+struct StartupPoke
+{
+  u32 address = 0;
+  u32 value = 0;
+  bool conditional = false;  // pokeifequal: only if the word at cond_address == cond_value
+  u32 cond_address = 0;
+  u32 cond_value = 0;
+};
+
+struct GameConfig
+{
+  std::optional<u32> code_list_start;  // codeliststart
+  std::optional<u32> code_list_end;    // codelistend
+  std::optional<u32> hook_type;        // hooktype (informational: Dolphin runs the handler each VI)
+  std::vector<StartupPoke> pokes;      // poke / pokeifequal, in file order
+};
+
+// Parses a Gecko OS gameconfig.txt for `game_id` (6 characters, e.g. "RSBE01"). Sections are
+// "RSB?01:" (? matches any character, a shorter id matches as a prefix) or "DEFAULT:"; the more
+// specific a section is, the later it is applied. searchandpoke / hook / ... are not supported.
+GameConfig ParseGameConfig(std::string_view text, std::string_view game_id);
+
+// Applies the poke / pokeifequal lines of the game's gameconfig.txt (SD root of the emulated SD
+// card) once, right after the game's executable is in memory and before it runs, as Gecko OS does.
+// Only when a Gecko OS code list (codes/<game id>.gct) is on the SD card, so a stray gameconfig.txt
+// doesn't touch an unmodded game. Does nothing outside the PS4 build.
+void ApplyGameConfigPokes(const Core::CPUThreadGuard& guard, const std::string& game_id);
