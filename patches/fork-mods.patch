+// ---- Gecko OS gameconfig.txt ------------------------------------------------------------------
+namespace
+{
+std::string_view Trim(std::string_view text)
+{
+  while (!text.empty() && (text.front() == ' ' || text.front() == '\t' || text.front() == '\r'))
+    text.remove_prefix(1);
+  while (!text.empty() && (text.back() == ' ' || text.back() == '\t' || text.back() == '\r' ||
+                           text.back() == '\n'))
+  {
+    text.remove_suffix(1);
+  }
+  return text;
+}
+
+// The hexadecimal numbers of "(a, b, c)" / "= a" / "a b c" in order; false on a stray character.
+bool ParseHexList(std::string_view text, std::vector<u32>* out)
+{
+  out->clear();
+  size_t i = 0;
+  while (i < text.size())
+  {
+    const char c = text[i];
+    if (c == ' ' || c == '\t' || c == ',' || c == '(' || c == '=')
+    {
+      i++;
+      continue;
+    }
+    if (c == ')')
+      break;
+    size_t end = i;
+    while (end < text.size() && std::isxdigit(static_cast<unsigned char>(text[end])) != 0)
+      end++;
+    if ((end < text.size() && text[end] == 'x' && end == i + 1 && text[i] == '0'))
+    {
+      // 0x prefix
+      i = end + 1;
+      end = i;
+      while (end < text.size() && std::isxdigit(static_cast<unsigned char>(text[end])) != 0)
+        end++;
+    }
+    if (end == i)
+      return false;
+    out->push_back(static_cast<u32>(std::strtoull(std::string(text.substr(i, end - i)).c_str(),
+                                                  nullptr, 16)));
+    i = end;
+  }
+  return true;
+}
+
+std::string LowerCase(std::string_view text)
+{
+  std::string result(text);
+  std::ranges::transform(result, result.begin(),
+                         [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return result;
+}
+}  // namespace
+
+GameConfig ParseGameConfig(std::string_view text, std::string_view game_id)
+{
+  struct Section
+  {
+    int specificity = 0;
+    std::vector<std::string_view> lines;
+  };
+  std::vector<Section> sections;
+  Section* current = nullptr;
+
+  size_t pos = 0;
+  while (pos <= text.size())
+  {
+    size_t eol = text.find_first_of("\r\n", pos);
+    if (eol == std::string_view::npos)
+      eol = text.size();
+    const std::string_view line = Trim(text.substr(pos, eol - pos));
+    pos = eol + 1;
+    if (line.empty() || line.front() == '#' || line.starts_with("//"))
+      continue;
+
+    // "RSB?01:" starts a section (the id may be followed by a comment)
+    const size_t colon = line.find(':');
+    if (colon != std::string_view::npos && line.find_first_of("=(") == std::string_view::npos)
+    {
+      const std::string_view id = Trim(line.substr(0, colon));
+      current = nullptr;
+      if (id.empty() || id.find(' ') != std::string_view::npos)
+        continue;
+      if (LowerCase(id) == "default")
+      {
+        sections.push_back({0, {}});
+        current = &sections.back();
+        continue;
+      }
+      if (id.size() > game_id.size())
+        continue;
+      bool match = true;
+      int specificity = 0;
+      for (size_t i = 0; i < id.size(); i++)
+      {
+        if (id[i] == '?')
+          continue;
+        if (id[i] != game_id[i])
+        {
+          match = false;
+          break;
+        }
+        specificity++;
+      }
+      if (!match)
+        continue;
+      sections.push_back({specificity, {}});
+      current = &sections.back();
+      continue;
+    }
+    if (current != nullptr)
+      current->lines.push_back(line);
+  }
+
+  std::ranges::stable_sort(sections,
+                           [](const Section& a, const Section& b) { return a.specificity < b.specificity; });
+
+  GameConfig config;
+  std::vector<u32> numbers;
+  for (const Section& section : sections)
+  {
+    for (const std::string_view line : section.lines)
+    {
+      const size_t key_end = line.find_first_of(" \t(=");
+      const std::string key = LowerCase(line.substr(0, key_end));
+      const std::string_view args = key_end == std::string_view::npos ? "" : line.substr(key_end);
+      if (key == "codeliststart" || key == "codelistend" || key == "hooktype")
+      {
+        if (!ParseHexList(args, &numbers) || numbers.size() != 1)
+          continue;
+        if (key == "codeliststart")
+          config.code_list_start = numbers[0];
+        else if (key == "codelistend")
+          config.code_list_end = numbers[0];
+        else
+          config.hook_type = numbers[0];  // decimal in Gecko OS, but only informational here
+      }
+      else if (key == "poke")
+      {
+        if (!ParseHexList(args, &numbers) || numbers.size() != 2)
+          continue;
+        config.pokes.push_back({numbers[0], numbers[1], false, 0, 0});
+      }
+      else if (key == "pokeifequal")
+      {
+        if (!ParseHexList(args, &numbers) || numbers.size() != 4)
+          continue;
+        config.pokes.push_back({numbers[2], numbers[3], true, numbers[0], numbers[1]});
+      }
+    }
+  }
+  return config;
+}
+
+#ifdef __ORBIS__
+namespace
+{
+constexpr char SD_CODES_CREATOR[] = "SD card (codes)";
+constexpr size_t MAX_SD_FILE_SIZE = 8 * 1024 * 1024;
+
+enum class SDSource
+{
+  None,
+  ModFolder,  // User/Load/ProjectM
+  Folder,     // User/Load/WiiSDSync
+  Image       // User/Load/WiiSD.raw
+};
+
+// The entry of `dir` called `name`, without regard to case: the console's file system tells
+// "RSBE01.gct" from "rsbe01.gct", the FAT card the mod was made on doesn't.
+std::optional<std::string> FindNoCase(const std::string& dir, const std::string& name)
+{
+  std::error_code error;
+  if (std::filesystem::exists(dir + "/" + name, error))
+    return name;
+  const std::string wanted = LowerCase(name);
+  std::filesystem::directory_iterator it(dir, error);
+  const std::filesystem::directory_iterator end;
+  for (; !error && it != end; it.increment(error))
+  {
+    const std::string found = it->path().filename().string();
+    if (LowerCase(found) == wanted)
+      return found;
+  }
+  return std::nullopt;
+}
+
+// `path` ("codes/RSBE01.gct") below the folder `root`, names matched without regard to case.
+bool ReadFromFolder(std::string root, const std::string& path, std::string* out)
+{
+  while (!root.empty() && root.back() == '/')
+    root.pop_back();
+  if (root.empty())
+    return false;
+  std::string current = root;
+  for (const std::string& part : SplitString(path, '/'))
+  {
+    if (part.empty())
+      continue;
+    const std::optional<std::string> name = FindNoCase(current, part);
+    if (!name)
+      return false;
+    current += "/" + *name;
+  }
+  std::string text;
+  if (!File::ReadFileToString(current, text) || text.size() > MAX_SD_FILE_SIZE)
+    return false;
+  *out = std::move(text);
+  return true;
+}
+
+// A file of the mod's SD card, by its path on the card ("codes/RSBE01.gct"; names are matched
+// without regard to case). Looked for in the mod folder (User/Load/ProjectM: the mod's files as
+// they are on its card), then the SD folder (User/Load/WiiSDSync), then the card image
+// (User/Load/WiiSD.raw): the mod works from any of them, with no unpacking.
+SDSource ReadSDFile(const std::string& path, std::string* out)
+{
+  const std::string load_dir = File::GetUserPath(D_LOAD_IDX);
+  std::string mod_folder = load_dir;
+  while (!mod_folder.empty() && mod_folder.back() == '/')
+    mod_folder.pop_back();
+  if (!mod_folder.empty())
+  {
+    if (const std::optional<std::string> name = FindNoCase(mod_folder, "ProjectM"))
+    {
+      if (ReadFromFolder(mod_folder + "/" + *name, path, out))
+        return SDSource::ModFolder;
+    }
+  }
+  if (ReadFromFolder(File::GetUserPath(D_WIISDCARDSYNCFOLDER_IDX), path, out))
+    return SDSource::Folder;
+  std::string text;
+  if (Common::ReadFileFromSDImage("/" + path, &text) && text.size() <= MAX_SD_FILE_SIZE)
+  {
+    *out = std::move(text);
+    return SDSource::Image;
+  }
+  return SDSource::None;
+}
+
+const char* SDSourceName(SDSource source)
+{
+  switch (source)
+  {
+  case SDSource::ModFolder:
+    return "ProjectM folder";
+  case SDSource::Folder:
+    return "SD folder";
+  default:
+    return "SD image";
+  }
+}
+
+// The names a game's Gecko OS code list can have: RSBE01.gct, RSB.gct, RSBE.gct.
+std::vector<std::string> GCTNames(const std::string& game_id)
+{
+  return {game_id + ".gct", game_id.substr(0, 3) + ".gct", game_id.substr(0, 4) + ".gct"};
+}
+
+u32 BigEndianWord(const std::string& raw, size_t offset)
+{
+  return (static_cast<u32>(static_cast<u8>(raw[offset])) << 24) |
+         (static_cast<u32>(static_cast<u8>(raw[offset + 1])) << 16) |
+         (static_cast<u32>(static_cast<u8>(raw[offset + 2])) << 8) |
+         static_cast<u32>(static_cast<u8>(raw[offset + 3]));
+}
+}  // namespace
+
+// Reads a Gecko OS code list (.gct): 00D0C0DE 00D0C0DE, code lines, F0000000 00000000. Whatever
+// follows the end marker is ignored. Nothing is added when the game has no code list.
+static void LoadGCTFromSD(std::vector<GeckoCode>& gcodes)
+{
+  // A code list region from an earlier game must not outlive it.
+  SetCodeListRegion(0, 0);
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+  if (game_id.size() < 4)
+    return;
+  for (const std::string& name : GCTNames(game_id))
+  {
+    std::string raw;
+    const SDSource source = ReadSDFile("codes/" + name, &raw);
+    if (source == SDSource::None)
+      continue;
+    if (raw.size() < 16 || BigEndianWord(raw, 0) != 0x00D0C0DE || BigEndianWord(raw, 4) != 0x00D0C0DE)
+    {
+      WARN_LOG_FMT(ACTIONREPLAY, "GCT {} ({}) is not a Gecko code list", name, SDSourceName(source));
+      continue;
+    }
+    GeckoCode gcode;
+    gcode.name = "GCT: " + name;
+    gcode.creator = SD_CODES_CREATOR;
+    gcode.enabled = true;
+    gcode.default_enabled = true;
+    for (size_t offset = 8; offset + 8 <= raw.size(); offset += 8)
+    {
+      const u32 address = BigEndianWord(raw, offset);
+      const u32 data = BigEndianWord(raw, offset + 4);
+      if (address == 0xF0000000)  // end of the list
+        break;
+      GeckoCode::Code code;
+      code.address = address;
+      code.data = data;
+      code.original_line = fmt::format("{:08X} {:08X}", address, data);
+      gcode.codes.push_back(std::move(code));
+    }
+    if (gcode.codes.empty())
+      continue;
+
+    u32 capacity = INSTALLER_END_ADDRESS - INSTALLER_BASE_ADDRESS;
+
+    // Gecko OS keeps long lists (Project M: 64 KB) elsewhere in memory, as gameconfig.txt says:
+    // codeliststart = 80570000 / codelistend = 80580000.
+    std::string gameconfig;
+    const SDSource config_source = ReadSDFile("gameconfig.txt", &gameconfig);
+    if (config_source != SDSource::None)
+    {
+      const GameConfig config = ParseGameConfig(gameconfig, game_id);
+      if (config.code_list_start)
+      {
+        const u32 start = *config.code_list_start;
+        const u32 end = config.code_list_end.value_or(start + static_cast<u32>(raw.size()) + 16);
+        SetCodeListRegion(start, end);
+        capacity = end - start;
+        NOTICE_LOG_FMT(ACTIONREPLAY, "gameconfig.txt ({}): code list at {:08x}-{:08x}, hook type {}",
+                       SDSourceName(config_source), start, end, config.hook_type.value_or(1));
+      }
+    }
+    NOTICE_LOG_FMT(ACTIONREPLAY,
+                   "GCT {} ({}): {} code lines ({} bytes of Gecko code space; {} bytes fit)", name,
+                   SDSourceName(source), gcode.codes.size(), gcode.codes.size() * 8, capacity);
+    if (gcode.codes.size() * 8 + 8 > capacity)
+    {
+      WARN_LOG_FMT(ACTIONREPLAY,
+                   "GCT {} is bigger than the code space: add codeliststart / codelistend to "
+                   "gameconfig.txt (Gecko OS mods ship one)",
+                   name);
+    }
+    gcodes.push_back(std::move(gcode));
+    return;
+  }
+}
+
+void ApplyGameConfigPokes(const Core::CPUThreadGuard& guard, const std::string& game_id)
+{
+  if (!Config::AreCheatsEnabled() || game_id.size() < 4)
+    return;
+  // Only for a game with a Gecko OS code list on the card, so a stray gameconfig.txt doesn't touch
+  // an unmodded game.
+  std::string probe;
+  bool has_codes = false;
+  for (const std::string& name : GCTNames(game_id))
+  {
+    if (ReadSDFile("codes/" + name, &probe) != SDSource::None)
+    {
+      has_codes = true;
+      break;
+    }
+  }
+  if (!has_codes)
+    return;
+  std::string gameconfig;
+  const SDSource source = ReadSDFile("gameconfig.txt", &gameconfig);
+  if (source == SDSource::None)
+  {
+    Core::DisplayMessage("Gecko OS codes found, but there is no gameconfig.txt on the SD card", 8000);
+    return;
+  }
+
+  const GameConfig config = ParseGameConfig(gameconfig, game_id);
+  int applied = 0;
+  for (const StartupPoke& poke : config.pokes)
+  {
+    const auto valid = [](u32 address) { return address >= 0x80000000 && address < 0x81800000; };
+    if (!valid(poke.address) || (poke.conditional && !valid(poke.cond_address)))
+    {
+      WARN_LOG_FMT(ACTIONREPLAY, "gameconfig.txt: poke at {:08x} is outside MEM1, skipped",
+                   poke.address);
+      continue;
+    }
+    if (poke.conditional &&
+        PowerPC::MMU::HostRead<u32>(guard, poke.cond_address) != poke.cond_value)
+    {
+      continue;
+    }
+    PowerPC::MMU::HostWrite<u32>(guard, poke.value, poke.address);
+    applied++;
+  }
+  NOTICE_LOG_FMT(ACTIONREPLAY, "gameconfig.txt ({}): {} of {} pokes applied", SDSourceName(source),
+                 applied, config.pokes.size());
+  Core::DisplayMessage(
+      fmt::format("Gecko OS mod: gameconfig.txt read from the {} ({} startup pokes)",
+                  SDSourceName(source), applied),
+      8000);
+}
+#else
+void ApplyGameConfigPokes(const Core::CPUThreadGuard&, const std::string&)
+{
+}
+#endif
